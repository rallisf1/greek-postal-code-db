{
  "name": "rallisf1/greek-postal-code-db",
  "description": "Read-only Greek postal-code data for PHP, backed by an embedded SQLite database.",
  "keywords": ["greece", "greek", "postcode", "postal-code", "sqlite"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Rallisf1\\GreekPostalCodeDb\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rallisf1\\GreekPostalCodeDb\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "build": "php scripts/build.php",
    "test": [
      "@build",
      "phpunit"
    ]
  },
  "support": {
    "issues": "https://github.com/rallisf1/greek-postal-code-db/issues",
    "source": "https://github.com/rallisf1/greek-postal-code-db/tree/main/php"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1-dev"
    }
  }
}
